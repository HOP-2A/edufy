generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}
model User {
  id        String    @id @default(nanoid())
  username  String    @unique
  email     String    @unique
  clerkId   String    @unique
  createdAt DateTime  @default(now())
  roadmaps  Roadmap[]
}

model Roadmap {
  id          String           @id @default(nanoid())
  userId      String
  user        User             @relation(fields: [userId], references: [id])
  title       String
  description String           @default("")
  levelFrom   String?           
  levelTo     String?          
  purpose     String          
  projectQuestions ProjectQuestion[] 
  learningSections LearningSection[]
  createdAt   DateTime         @default(now())
}

model ProjectQuestion {
  id        String   @id @default(nanoid())
  roadmapId String
  roadmap   Roadmap  @relation(fields: [roadmapId], references: [id])
  text      String   
  answer    String? 
  asked  Boolean   @default(false)
}

model LearningSection {
  id          String      @id @default(nanoid())
  roadmapId   String
  roadmap     Roadmap     @relation(fields: [roadmapId], references: [id])
  title       String      
  level       String      
  content     String     
  resources   Resource[]
  tasks       Task[]
}

model Task {
  id                 String      @id @default(nanoid())
  learningSectionId  String
  learningSection    LearningSection @relation(fields: [learningSectionId], references: [id])
  title              String      
  content            String      
  completed          Boolean     @default(false)
  resources          Resource[]
  taskQuestions      TaskQuestion[] 
  order              Int         
}

model TaskQuestion {
  id         String   @id @default(nanoid())
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id])
  text       String  
  answer     String 
  userAnswer String?  
  isCorrect  Boolean? @default(false)
}

model Resource {
  id                 String      @id @default(nanoid())
  learningSectionId  String?     
  taskId             String?     
  learningSection    LearningSection? @relation(fields: [learningSectionId], references: [id])
  task               Task?       @relation(fields: [taskId], references: [id])
  type               ResourceType
  title              String
  url                String?     
}

enum ResourceType {
  VIDEO
  ARTICLE
  BOOK
  EXERCISE
  OTHER
}
